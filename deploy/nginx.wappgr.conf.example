# Dedicated virtual host. Replace wappgr.example.com and certificate paths.
# Do not replace the global nginx.conf or another site's server block.
server {
    listen 80;
    server_name wappgr.example.com;
    location /.well-known/acme-challenge/ { root /var/www/acme-wappgr; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name wappgr.example.com;
    ssl_certificate /etc/letsencrypt/live/wappgr.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wappgr.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;

    location = /api/webhooks/whatsapp {
        client_max_body_size 2m;
        # Verification queries contain the verify token; keep them out of access logs.
        access_log off;
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 35s;
    }
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
