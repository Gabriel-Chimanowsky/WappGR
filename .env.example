HOST=127.0.0.1
PORT=3001
WAPPGR_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# WAPPGR_DB_PATH=C:/absolute/path/wappgr.db
# WAPPGR_AUTH_DIR=C:/absolute/path/baileys_auth
# WAPPGR_RUNTIME_DIR=C:/absolute/path/runtime
# The Windows task loads this root .env by absolute path and forces NODE_ENV=production.
# Authorized HTTPS media hosts (comma separated); Meta fetches the link.
# Confirm supported media types and limits in the chosen Graph version.
WAPPGR_MEDIA_HOSTS=
# Set only for isolated operation without WhatsApp initialization:
# WAPPGR_DISABLE_WHATSAPP=1
# Operational transport: Meta Cloud API only. No QR, socket or Baileys fallback.
# Select a currently supported Graph version from your Meta app dashboard; no implicit default.
WAPPGR_GRAPH_VERSION=
WAPPGR_CLOUD_WABA_ID=
WAPPGR_CLOUD_PHONE_NUMBER_ID=
# Server-only secrets; never prefix these with VITE_ or commit a populated .env.
WAPPGR_CLOUD_TOKEN=
WAPPGR_META_APP_SECRET=
WAPPGR_WEBHOOK_VERIFY_TOKEN=
# Behind the dedicated local Nginx proxy only:
# WAPPGR_TRUST_PROXY=loopback
